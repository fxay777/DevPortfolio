{
  // Configuração da Cloudflare (Workers). Não coloque chaves secretas aqui!
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jacksonfb-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
